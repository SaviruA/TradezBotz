# Copy to .env and fill in. NEVER commit .env

# --- SEC EDGAR -------------------------------------------------------------
# Required by the SEC: a contact string including a real email address.
# Requests without this are blocked.
SEC_USER_AGENT="TradezBotz research your.email@example.com"

# --- Massive (formerly Polygon.io) ----------------------------------------
MASSIVE_API_KEY=

# Flat Files (S3) bulk historical access
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles

# --- Alpaca (Phase 3, paper only) -----------------------------------------
# Live keys use ALPACA_LIVE_* so paper credentials can never reach live.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
